 catch(err){$('#unlockErr').textContent=err.message==='NOSUBTLE'?'This browser blocks encryption on this page (it needs https or a local file). Use the box below to paste your Groq key for this session instead.':'Wrong passphrase. Try again.';if(err.message==='NOSUBTLE')$('#rawWrap').style.display='block'}});
