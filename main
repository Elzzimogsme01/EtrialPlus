/* ---------- images ---------- */
function fileToDataURL(file){return new Promise((res,rej)=>{const fr=new FileReader();fr.onerror=rej;fr.onload=()=>{const img=new Image();img.onerror=rej;img.onload=()=>{const M=1280,s=Math.min(1,M/Math.max(img.width,img.height));const c=document.createElement('canvas');c.width=Math.round(img.width*s);c.height=Math.round(img.height*s);c.getContext('2d').drawImage(img,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.82))};img.src=fr.result};fr.readAsDataURL(file)})}
async function addFiles(files){
 const imgs=[...files].filter(f=>f.type.startsWith('image/'));if(!imgs.length)return;
 for(const f of imgs){if(pending.length>=4){toast('Up to 4 images per message');break}try{pending.push(await fileToDataURL(f))}catch{toast('Could not read that image')}}
 renderChips();
}
function renderChips(){
 const el=$('#chips');el.innerHTML='';
 pending.forEach((u,i)=>{const d=document.createElement('div');d.className='chip';const im=new Image();im.src=u;const b=document.createElement('button');b.type='button';b.textContent='✕';b.onclick=()=>{pending.splice(i,1);renderChips()};d.append(im,b);el.appendChild(d)});
 updateMeter();
}
$('#attachBtn').onclick=()=>$('#fileInput').click();
$('#fileInput').onchange=e=>{addFiles(e.target.files);e.target.value=''};
addEventListener('paste',e=>{const fs=[...(e.clipboardData?.items||[])].filter(i=>i.kind==='file'&&i.type.startsWith('image/')).map(i=>i.getAsFile());if(fs.length){e.preventDefault();addFiles(fs);toast('Image pasted')}});
let dragN=0;
addEventListener('dragenter',e=>{if([...(e.dataTransfer?.types||[])].includes('Files')){dragN++;$('#dropmsg').classList.add('show');$('.composer').classList.add('drag')}});
addEventListener('dragleave',()=>{dragN=Math.max(0,dragN-1);if(!dragN){$('#dropmsg').classList.remove('show');$('.composer').classList.remove('drag')}});
addEventListener('dragover',e=>e.preventDefault());
addEventListener('drop',e=>{e.preventDefault();dragN=0;$('#dropmsg').classList.remove('show');$('.composer').classList.remove('drag');addFiles(e.dataTransfer.files)});

