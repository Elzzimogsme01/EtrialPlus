/* ---------- panic key ---------- */
function panic(){
 try{document.documentElement.innerHTML='<body style="background:#fff"></body>'}catch{}
 try{window.open('','_self');window.close()}catch{}
 location.replace('about:blank');
}
addEventListener('keydown',e=>{
 if(cfg.panic&&(e.ctrlKey||e.metaKey)&&(e.key==='0'||e.code==='Digit0'||e.code==='Numpad0')){e.preventDefault();e.stopImmediatePropagation();panic()}
 if(e.key==='Escape'){closeSettings()}
},true);

