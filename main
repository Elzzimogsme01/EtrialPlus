/* ---------- send ---------- */
async function send(text){
 text=(text||'').trim();const imgs=pending.slice();
 if((!text&&!imgs.length)||busy)return;
 if(!currentId){currentId=crypto.randomUUID();conversations.push({id:currentId,title:(text||'Image').slice(0,38)+(text.length>38?'…':''),messages:[]})}
 const c=active();c.messages.push({role:'user',content:text,img:imgs.length||undefined});
 $('#welcome').style.display='none';addMessage('user',text,{thumbs:imgs});renderHistory();save();
 $('#promptInput').value='';$('#promptInput').style.height='auto';pending=[];renderChips();setBusy(true);
 const bubble=addMessage('assistant','');
 try{
  const answer=await requestAI(c.messages.slice(-20),imgs,t=>{bubble.dataset.raw=t;bubble.innerHTML=md(t);scrollBottom()});
  bubble.dataset.raw=answer;bubble.innerHTML=md(answer);
  c.messages.push({role:'assistant',content:answer});save();
 }catch(e){
  const msg=e?.message||'AI provider is not connected.';
  bubble.dataset.raw=msg;bubble.innerHTML=md('**Something went wrong**\n\n'+msg);
  c.messages.pop();save();
 }
 setBusy(false);updateMeter();$('#promptInput').focus();scrollBottom();
}

