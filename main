/* ---------- starfield with warp zoom ---------- */
const warp={speed:.05,target:.0016};
(()=>{
 const cv=$('#stars'),x=cv.getContext('2d');let W,H,D=devicePixelRatio||1,S=[],mx=0,my=0;
 const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
 const mk=()=>({x:Math.random()*2-1,y:Math.random()*2-1,z:Math.random()*.98+.02});
 function resize(){W=cv.width=innerWidth*D;H=cv.height=innerHeight*D;S=Array.from({length:Math.min(260,Math.floor(innerWidth/5))},mk)}
 addEventListener('resize',resize);resize();
 addEventListener('pointermove',e=>{mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5},{passive:true});
 let px=0,py=0;
 function draw(){
  x.fillStyle='rgba(0,0,0,.35)';x.fillRect(0,0,W,H);
  if(reduce)warp.speed=0;else warp.speed+=(warp.target-warp.speed)*.035;
  px+=(mx-px)*.05;py+=(my-py)*.05;
  const cx=W/2,cy=H/2,k=Math.max(W,H)*.32;
  for(const s of S){
   const pz=s.z;s.z-=warp.speed;
   const sx=cx+(s.x/s.z)*k+px*60*D*(1-s.z),sy=cy+(s.y/s.z)*k+py*60*D*(1-s.z);
   if(s.z<=.02||sx<0||sx>W||sy<0||sy>H){Object.assign(s,mk(),{z:1});continue}
   const ox=cx+(s.x/pz)*k+px*60*D*(1-pz),oy=cy+(s.y/pz)*k+py*60*D*(1-pz);
   const a=Math.min(1,(1-s.z)*1.25);
   x.strokeStyle='rgba(255,255,255,'+a+')';x.lineWidth=Math.max(.5,(1-s.z)*1.8)*D;
   x.beginPath();x.moveTo(ox,oy);x.lineTo(sx+.01,sy);x.stroke();
  }
  requestAnimationFrame(draw);
 }
 draw();
})();

