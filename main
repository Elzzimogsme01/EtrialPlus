<script>
const $=s=>document.querySelector(s);
const LS={get(k,d){try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch{return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch{}},del(k){try{localStorage.removeItem(k)}catch{}}};

/* ---------- AI: Groq ---------- */
// The API key is NOT stored in plain text. EMBEDDED_KEY is AES-GCM encrypted (PBKDF2-SHA256, 200k iterations);
// you unlock it with your passphrase. Note: once unlocked, the key lives in browser memory and requests go
// straight to Groq, so keep this file private (personal use only; don't host it publicly).
const EMBEDDED_KEY='MVDB/OKBKrZYWMFsc/RkMaOJUFBR5hFULnKo5KC1xB8Rd7Ixh5xnfaWM+qleDUFxj+RRwgKSJhCdlo8XaQLeSNPXJlIUQ8WZu7E1CXKb/dGEkB14VuSWqOqfDSOO9AQUC2ohxQ==';
const GROQ_URL='https://api.groq.com/openai/v1/chat/completions';
const DEFAULT_MODELS={text:'openai/gpt-oss-120b',vision:'qwen/qwen3.8-27b'};
const SYSTEM_PROMPT="You are E's AI, a helpful, concise assistant. Use Markdown when it helps (lists, code blocks).";
const b64={enc:u=>btoa(String.fromCharCode(...u)),dec:s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0))};
async function deriveKey(pass,salt,usage){const km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pass),'PBKDF2',false,['deriveKey']);return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:200000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,[usage])}
async function decryptKey(blob,pass){const a=b64.dec(blob);const k=await deriveKey(pass,a.slice(0,16),'decrypt');return new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:a.slice(16,28)},k,a.slice(28)))}
async function encryptKey(key,pass){const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12));const k=await deriveKey(pass,salt,'encrypt');const ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},k,new TextEncoder().encode(key)));const all=new Uint8Array(28+ct.length);all.set(salt,0);all.set(iv,16);all.set(ct,28);return b64.enc(all)}

let apiKey=null,unlockWaiters=[];
const keyBlob=()=>LS.get('esai_keyenc',null)||EMBEDDED_KEY;
async function tryUnlock(pass,remember){
 pass=(pass||'').trim();
 if(!window.crypto||!crypto.subtle){const e=new Error('NOSUBTLE');throw e}
 const k=await decryptKey(keyBlob(),pass);
 apiKey=k;try{sessionStorage.setItem('esai_pass',pass)}catch{}
 if(remember)LS.set('esai_pass',pass);
 setConn('on','Groq connected');updateMeter();
 unlockWaiters.splice(0).forEach(r=>r(k));return k;
}
async function autoUnlock(){
 for(const p of [sessionStorage.getItem('esai_pass'),LS.get('esai_pass',null)]){if(p){try{return await tryUnlock(p,false)}catch{}}}
 return null;
}
function askUnlock(){
 $('#unlockErr').textContent='';$('#unlockPass').value='';$('#unlockOverlay').classList.add('open');setTimeout(()=>$('#unlockPass').focus(),50);
 return new Promise((res,rej)=>{unlockWaiters.push(res);askUnlock.rej=rej});
}
async function getKey(){return apiKey||await autoUnlock()||await askUnlock()}
function lockNow(){apiKey=null;try{sessionStorage.removeItem('esai_pass')}catch{}LS.del('esai_pass');setConn('off','Locked');updateMeter()}

const models=()=>({text:(cfg.mText||DEFAULT_MODELS.text),vision:(cfg.mVision||DEFAULT_MODELS.vision)});
function toApiMessages(messages,images){
 const out=[{role:'system',content:SYSTEM_PROMPT}];
 messages.forEach((m,i)=>{
  const last=i===messages.length-1;
  if(last&&m.role==='user'&&images&&images.length){
   out.push({role:'user',content:[{type:'text',text:m.content||'Describe this image.'},...images.slice(0,3).map(u=>({type:'image_url',image_url:{url:u}}))]});
  }else out.push({role:m.role,content:m.content||(m.img?'[image]':'')});
 });
 return out;
}
const stripThink=t=>t.replace(/<think>[\s\S]*?(<\/think>|$)/g,'').replace(/^\s+/,'');
async function requestAI(messages,images,onChunk){
 const key=await getKey();
 const useVision=images&&images.length;
 const res=await fetch(GROQ_URL,{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
  body:JSON.stringify({model:useVision?models().vision:models().text,messages:toApiMessages(messages,images),stream:true,temperature:.7,max_completion_tokens:4096})});
 if(!res.ok){
  let d='';try{const j=await res.json();d=j.error?.message||''}catch{}
  if(res.status===401)throw new Error('Groq rejected the API key (401). Check it in Settings.');
  if(res.status===429)throw new Error('Groq rate limit reached (429). Wait a moment and try again.');
  throw new Error('Groq error '+res.status+(d?': '+d:'')+(res.status===404||res.status===400?'\n\nThe model may have been retired. Change model IDs in Settings.':''));
 }
 const rd=res.body.getReader(),dec=new TextDecoder();let buf='',full='';
 for(;;){
  const {done,value}=await rd.read();if(done)break;
  buf+=dec.decode(value,{stream:true});
  let i;while((i=buf.indexOf('\n'))>=0){
   const line=buf.slice(0,i).trim();buf=buf.slice(i+1);
   if(!line.startsWith('data:'))continue;const p=line.slice(5).trim();if(p==='[DONE]')continue;
   try{const t=JSON.parse(p).choices?.[0]?.delta?.content;if(t){full+=t;onChunk&&onChunk(stripThink(full))}}catch{}
  }
 }
 full=stripThink(full);
 if(!full)throw new Error('The model returned an empty reply.');
 return full;
}

/* ---------- state ---------- */
const STORE='esai_conversations_v1';
let conversations=LS.get(STORE,[]);
let currentId=null,busy=false,pending=[];
const active=()=>conversations.find(c=>c.id===currentId);
const save=()=>LS.set(STORE,conversations);
const cfg=Object.assign({panic:true},LS.get('esai_cfg',{}));
const saveCfg=()=>LS.set('esai_cfg',{panic:cfg.panic,mText:cfg.mText||'',mVision:cfg.mVision||''});
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove('show'),2800)}
const esc=s=>s.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ---------- markdown ---------- */
function md(src){
 const blocks=[];
 src=src.replace(/```(\w*)[ \t]*\n?([\s\S]*?)(```|$)/g,(m,l,c)=>{blocks.push({l,c:c.replace(/\n$/,'')});return '\n\u0000'+(blocks.length-1)+'\u0000\n'});
 let h=esc(src);
 h=h.replace(/^#{3,4} (.*)$/gm,'<h4>$1</h4>').replace(/^#{1,2} (.*)$/gm,'<h3>$1</h3>');
 h=h.replace(/(?:^|\n)((?:[-*] .+(?:\n|$))+)/g,(m,l)=>'\n<ul>'+l.trim().split('\n').map(x=>'<li>'+x.replace(/^[-*] /,'')+'</li>').join('')+'</ul>\n');
 h=h.replace(/(?:^|\n)((?:\d+[.)] .+(?:\n|$))+)/g,(m,l)=>'\n<ol>'+l.trim().split('\n').map(x=>'<li>'+x.replace(/^\d+[.)] /,'')+'</li>').join('')+'</ol>\n');
 h=h.replace(/\*\*([^*\n]+)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*\w])\*([^*\n]+)\*/g,'$1<em>$2</em>').replace(/`([^`\n]+)`/g,'<code>$1</code>');
 h=h.replace(/\n*(<\/?(?:ul|ol|h3|h4)>)\n*/g,'$1').replace(/\n*\u0000(\d+)\u0000\n*/g,'\u0000$1\u0000').replace(/^\n+|\n+$/g,'').replace(/\n/g,'<br>');
 return h.replace(/\u0000(\d+)\u0000/g,(m,i)=>{const b=blocks[i];return '<div class="code"><div class="code-head"><span>'+(esc(b.l)||'code')+'</span><button type="button" class="copy">Copy</button></div><pre><code>'+esc(b.c)+'</code></pre></div>'});
}

/* ---------- ui ---------- */
function setConn(state,text){$('#dot').className='dot '+state;$('#connText').textContent=text}
function renderHistory(){
 const el=$('#history');el.innerHTML='';
 if(!conversations.length){el.innerHTML='<div class="empty-hist">No chats yet.</div>';return}
 [...conversations].reverse().forEach(c=>{
  const row=document.createElement('div');row.className='hi'+(c.id===currentId?' active':'');
  const b=document.createElement('button');b.className='t';b.textContent=c.title||'New chat';b.onclick=()=>openChat(c.id);
  const x=document.createElement('button');x.className='x';x.textContent='✕';x.title='Delete chat';x.onclick=e=>{e.stopPropagation();conversations=conversations.filter(k=>k.id!==c.id);save();if(currentId===c.id)newChat();else renderHistory()};
  row.append(b,x);el.appendChild(row);
 });
}
function newChat(){currentId=null;$('#messages').innerHTML='';const w=$('#welcome');w.style.display='block';w.style.animation='none';void w.offsetWidth;w.style.animation='';renderHistory();$('#promptInput').focus();$('#sidebar').classList.remove('open');updateMeter()}
function openChat(id){currentId=id;const c=active();$('#welcome').style.display='none';$('#messages').innerHTML='';c.messages.forEach(m=>addMessage(m.role,m.content,{img:m.img}));renderHistory();scrollBottom();$('#sidebar').classList.remove('open')}
function addMessage(role,content,o={}){
 const row=document.createElement('div');row.className='message '+role;
 const name=document.createElement('div');name.className='msg-name';
 name.innerHTML=role==='user'?'<span>You</span>':"<b>E's AI</b>";
 const bubble=document.createElement('div');bubble.className='bubble';
 if(role==='assistant'){
  const cp=document.createElement('button');cp.type='button';cp.className='msg-copy';cp.textContent='Copy';name.appendChild(cp);
  bubble.dataset.raw=content;if(content)bubble.innerHTML=md(content);
 }else{
  if(o.thumbs&&o.thumbs.length){const t=document.createElement('div');t.className='thumbs';o.thumbs.forEach(u=>{const im=new Image();im.src=u;t.appendChild(im)});row.append(name,t,bubble)}
  else if(o.img){const t=document.createElement('div');t.className='img-tag';t.textContent='['+o.img+' image'+(o.img>1?'s':'')+' attached]';row.append(name,t,bubble)}
  bubble.textContent=content;
 }
 if(!row.children.length)row.append(name,bubble);
 $('#messages').appendChild(row);if(o.scroll!==false)scrollBottom();return bubble;
}
const scrollBottom=()=>{const s=$('#chatScroll');s.scrollTop=s.scrollHeight};
function setBusy(v){busy=v;$('#sendBtn').disabled=v}
document.addEventListener('click',e=>{
 const c=e.target.closest('.copy');if(c){const t=c.closest('.code').querySelector('code').textContent;navigator.clipboard.writeText(t).then(()=>{c.textContent='Copied';setTimeout(()=>c.textContent='Copy',1400)});return}
 const m=e.target.closest('.msg-copy');if(m){const raw=m.closest('.message').querySelector('.bubble').dataset.raw||'';navigator.clipboard.writeText(raw).then(()=>{m.textContent='Copied';setTimeout(()=>m.textContent='Copy',1400)})}
});

